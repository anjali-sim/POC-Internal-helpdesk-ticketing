# Optional. Leave unset in development: Vite proxies /api to the Express server
# on port 4000 (see vite.config.ts), which keeps the browser same-origin so the
# httpOnly auth cookie is sent as a plain first-party cookie.
#
# Set this only when the API is served from a different origin than the app,
# e.g. a deployed build. The API must then list that origin in CORS_ORIGIN and
# the cookie must be SameSite=None; Secure.
# VITE_API_BASE_URL="https://api.example.com/api"
