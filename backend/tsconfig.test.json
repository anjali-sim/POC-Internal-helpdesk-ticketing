{
  // Type-checks the test files, which the build tsconfig excludes so they never
  // land in dist/. Vitest transpiles without checking types, so this is what
  // catches a test that no longer matches the code it covers.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"],
  "exclude": []
}
